@{
    var tab = ViewData["Tab"] as string ?? "";
    var titulo = ViewData["Titulo"] as string ?? "Panel de cámaras";
    var volver = ViewData["Volver"] as string;
    // Ancho: "completo" aprovecha todo el ancho (mosaico, directo, grabaciones); el resto se limita para que los formularios se lean bien.
    var ancho = (ViewData["Ancho"] as string) == "completo" ? "completo" : "estrecho";
    var clsBody = "xm" + (ViewData["Cam"] != null ? " cam" : "");
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>@titulo · Panel Camaras</title>
<script>
  // Aplica el tema guardado antes de pintar (evita el parpadeo).
  (function(){ try {
    var t = localStorage.getItem('xm.theme') || 'NVR_DARK';
    var f = localStorage.getItem('xm.follow'); f = (f === null) ? true : f === 'true';
    var dark = matchMedia('(prefers-color-scheme: dark)').matches;
    var D = { NVR_DARK: 1, AMOLED: 1, CYBER: 1 };
    var r = !f ? t : (!!D[t] === dark ? t : (dark ? 'NVR_DARK' : 'MATERIAL_LIGHT'));
    document.documentElement.setAttribute('data-theme', r);
  } catch (e) {} })();
</script>
<link rel="stylesheet" href="~/css/xmcam.css">
</head>
<body class="@clsBody">
<header class="topbar">
  @if (!string.IsNullOrEmpty(volver)) { <a class="ib" href="@volver" title="Atrás" aria-label="Atrás"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></a> }
  <a class="logo" href="/"><i class="lg"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3z"/></svg></i><span>Panel Camaras</span></a>
  @await Html.PartialAsync("_Barra", tab)
  <div class="topcams" id="topcams" data-cam="@ViewData["CamId"]" aria-label="Cámaras"></div>
  <div class="acc" id="acc">@RenderSection("Acciones", required: false)</div>
  <button class="ib" id="bMas" type="button" title="Más" aria-label="Más acciones" aria-haspopup="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg></button>
  <button class="ib" id="bTema" type="button" title="Cambiar tema" aria-label="Cambiar tema"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
</header>
<main class="xm-main @ancho">
  @RenderBody()
</main>
<script src="~/js/xmcam.js"></script>
<script src="~/js/xmcam-avisos.js"></script>
<script src="~/js/xmcam-topcams.js"></script>
<script>
  // Menú "⋯" (solo móvil): agrupa los botones propios de cada página; se oculta si la página no tiene ninguno.
  (function(){
    var acc = document.getElementById('acc'), mas = document.getElementById('bMas');
    if (!acc.children.length){ mas.hidden = true; return; }
    mas.onclick = function(e){ e.stopPropagation(); acc.classList.toggle('open'); };
    document.addEventListener('click', function(){ acc.classList.remove('open'); });
  })();
  // Botón de tema de la barra: pasa al siguiente tema y desactiva "seguir el modo del sistema".
  document.getElementById('bTema').onclick = function(){
    var T = XM.THEMES, cur = XM.store.get('theme', 'NVR_DARK'), i = T.findIndex(function(t){ return t.id === cur; });
    XM.store.set('theme', T[(i + 1) % T.length].id); XM.store.set('follow', 'false'); XM.applyTheme(); XM.toast(T[(i + 1) % T.length].label);
  };
</script>
@RenderSection("Scripts", required: false)
</body>
</html>
