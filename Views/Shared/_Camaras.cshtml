@{
    var tab = ViewData["Tab"] as string ?? "";
    var titulo = ViewData["Titulo"] as string ?? "Panel de cámaras";
    var volver = ViewData["Volver"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@titulo · PanelCamaras</title>
<script>
  // Aplica el tema guardado antes de pintar (evita el parpadeo).
  (function(){ try {
    var t = localStorage.getItem('xm.theme') || 'NVR_DARK';
    var f = localStorage.getItem('xm.follow'); f = (f === null) ? true : f === 'true';
    var dark = matchMedia('(prefers-color-scheme: dark)').matches;
    var D = { NVR_DARK: 1, AMOLED: 1, CYBER: 1 };
    var r = !f ? t : (!!D[t] === dark ? t : (dark ? 'NVR_DARK' : 'MATERIAL_LIGHT'));
    document.documentElement.setAttribute('data-theme', r);
  } catch (e) {} })();
</script>
<link rel="stylesheet" href="~/css/xmcam.css">
</head>
<body class="xm">
<header class="appbar">
  @if (!string.IsNullOrEmpty(volver)) { <a class="back" href="@volver" aria-label="Atrás">←</a> }
  <h1>@titulo</h1>
  @RenderSection("Acciones", required: false)
</header>
<main class="xm-main">
  @RenderBody()
</main>
<nav class="navbar" aria-label="Principal">
  <a href="/" class="@(tab == "mosaico" ? "sel" : "")"><svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>Mosaico</a>
  <a href="/grabaciones" class="@(tab == "grabaciones" ? "sel" : "")"><svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10z"/></svg>Grabaciones</a>
  <a href="/ajustes" class="@(tab == "ajustes" ? "sel" : "")"><svg viewBox="0 0 24 24"><path d="M19.4 13a7.5 7.5 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.6 7.6 0 0 0-1.7-1l-.4-2.6h-4l-.4 2.6c-.6.3-1.2.6-1.7 1l-2.5-1-2 3.5L4.6 11a7.5 7.5 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1c.5.4 1.1.7 1.7 1l.4 2.6h4l.4-2.6c.6-.3 1.2-.6 1.7-1l2.5 1 2-3.5zM12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7z"/></svg>Ajustes</a>
</nav>
<script src="~/js/xmcam.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
