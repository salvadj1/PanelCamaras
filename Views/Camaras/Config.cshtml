@{
    Layout = "_Camaras";
    ViewData["Titulo"] = "Configuración";
    ViewData["Tab"] = "camaras";
    ViewData["Volver"] = "/camara/" + ViewData["CamId"] + "?panel=ajustes";
}
<div id="camSel" class="chips camsel" aria-label="Cambiar de cámara"></div>
<div id="cfg" data-cam="@ViewData["CamId"]"><p class="mut">Cargando…</p></div>
<div class="cfgbar">
  <button class="btn out" id="bJson" type="button">Ver JSON</button>
  <button class="btn tonal" id="bRec" type="button">Recargar</button>
  <button class="btn" id="bGuardar" type="button">Guardar</button>
</div>
<pre id="jsonRaw" class="small" hidden style="white-space:pre-wrap;overflow-wrap:anywhere;user-select:all;background:var(--surface-variant);border-radius:10px;padding:10px;max-height:50vh;overflow:auto"></pre>
@section Scripts {
  <script src="~/js/xmcam-schemas.js"></script>
  <script src="~/js/xmcam-config.js"></script>
}
